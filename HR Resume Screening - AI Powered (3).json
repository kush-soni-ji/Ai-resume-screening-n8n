    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const text = item.json.text || \"\"; \n  \n  // Updated Regex: Yeh https:// ke bina bhi kaam karega\n  const linkedinRegex = /((https?:\\/\\/)?(www\\.)?linkedin\\.com\\/in\\/[a-zA-Z0-9_-]+)/i;\n  \n  const match = text.match(linkedinRegex);\n  \n  // Agar link mil jaye toh save karein, nahi toh \"Not Found\"\n  item.json.linkedin_url = match ? match[0] : \"Not Found\";\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -3152,
        656
      ],
      "id": "4dc1d2b6-2af1-44ea-9818-d2119861234b",
      "name": "Extract the link"
    },
    {
      "parameters": {
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n    \"profileScraperMode\": \"Profile details no email ($4 per 1k)\",\n    \"queries\": [\n        \"{{ $json.linkedin_url }}\"\n    ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -2928,
        656
      ],
      "id": "f00f85eb-52b7-4e3a-a064-a3cef5d5c1ee",
      "name": "Scrape the profile"
    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const profile = item.json;\n\n  // 1. Extract Experience (Sirf candidate ka)\n  const experience = (profile.experience || []).map(exp => ({\n    title: exp.position,\n    company: exp.companyName,\n    startDate: exp.startDate ? exp.startDate.text : 'N/A',\n    endDate: exp.endDate ? exp.endDate.text : 'Present',\n    description: exp.description\n  }));\n\n  // 2. Extract Education\n  const education = (profile.education || []).map(edu => ({\n    school: edu.schoolName,\n    degree: edu.degree,\n    field: edu.fieldOfStudy\n  }));\n\n  // 3. Extract Skills\n  const skills = (profile.skills || []).map(s => s.name);\n\n  // 4. Final Clean Object (Isme 'moreProfiles' nahi hai)\n  item.json.clean_linkedin_data = {\n    full_name: `${profile.firstName} ${profile.lastName}`,\n    headline: profile.headline,\n    location: profile.location ? profile.location.linkedinText : 'N/A',\n    experience_summary: experience,\n    education_summary: education,\n    skills_list: skills\n  };\n\n  // Optional: Purana saara kachra data delete karne ke liye\n  // Taaki AI ko sirf 'clean_linkedin_data' hi dikhe\n  const cleanData = item.json.clean_linkedin_data;\n  item.json = { clean_linkedin_data: cleanData };\n}\n\nreturn $input.all();"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2704,
        656
      ],
      "id": "81842834-2cb3-402b-b6ff-b2257b01b8ae",
      "name": "Get the neccesary info"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert Forensic Recruitment Auditor with 15 years of experience in background verification.\nYour task is to cross-reference the provided \"Resume Text\" with the \"LinkedIn Scraped Data\" to find discrepancies, hidden gaps, or fabrications.\n\nINPUTS:\n1. Resume Text: {{ $json.text }}\n2. LinkedIn Data: \n\nVERIFICATION GUIDELINES:\n- Compare Company Names: Do they match exactly?\n- Compare Employment Dates: Check for date inflations in the resume.\n- Compare Job Titles: Is a 'Freelancer' on LinkedIn being called a 'Senior Lead' on the resume?\n- Skill Consistency: Are the skills mentioned in the resume also reflected in LinkedIn's 'Top Skills' or 'Headline'?\n- Education Check: Verify degree and university matches.\n\nOUTPUT FORMAT (Strict JSON):\nReturn ONLY a JSON object with this structure:\n{\n  \"verification_status\": \"MATCHED\" | \"MISMATCHED\" | \"PARTIAL_MATCH\",\n  \"discrepancies\": [\n    \"List specific differences found (e.g., Job title mismatch at Company X)\",\n    \"List date gaps found\"\n  ],\n  \"authenticity_score\": <integer 0-100>,\n  \"verification_summary\": \"A 2-sentence summary of the profile's honesty.\"\n}",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -2256,
        720
      ],
      "id": "8ac1893a-f071-4420-b215-1faeda552277",
      "name": "Verify Agent"
    },
    {
      "parameters": {
        "jsCode": "const rawOutput = $input.item.json.output;\nconst parsed = JSON.parse(rawOutput);\nreturn {\n  ...parsed\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1904,

    {
      "parameters": {
        "jsCode": "// AI response \"output\" field mein string hai\nconst rawOutput = $input.item.json.output;\n\nlet parsed;\ntry {\n  const cleaned = rawOutput.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  parsed = {\n    score: 0,\n    decision: 'REJECTED',\n    match_percentage: 0,\n    strengths: [],\n    gaps: ['Error parsing AI response'],\n    summary: 'Could not analyze resume. Manual review needed.',\n    recommended_interview_type: 'None'\n  };\n}\n\n// Form se candidate info\nconst candidateName    = $('Job Application Form').item.json['Full Name'];\nconst candidateEmail   = $('Job Application Form').item.json['Email Address'];\nconst candidatePhone   = $('Job Application Form').item.json['Phone Number'] || 'N/A';\nconst jobPosition      = $('Job Application Form').item.json['Job Position Applied For'];\nconst yearsExp         = $('Job Application Form').item.json['Years of Experience'];\n\nconst submissionId = 'APP-' + Date.now();\nconst submittedAt  = new Date().toISOString();\n\nreturn {\n  submission_id:      submissionId,\n  candidate_name:     candidateName,\n  candidate_email:    candidateEmail,\n  candidate_phone:    candidatePhone,\n  job_position:       jobPosition,\n  years_experience:   yearsExp,\n  submitted_at:       submittedAt,\n\n  ai_score:           parsed.score,\n  decision:           parsed.decision,\n  match_percentage:   parsed.match_percentage,\n  strengths:          parsed.strengths.join(' | '),\n  gaps:               parsed.gaps.join(' | '),\n  summary:            parsed.summary,\n  interview_type:     parsed.recommended_interview_type\n};"
      },

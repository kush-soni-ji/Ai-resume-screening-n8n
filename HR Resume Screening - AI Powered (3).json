      ],
      "id": "974f87a4-5748-486e-8bd2-21892b4b2b2c",
      "name": "Output in the readable Form"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert Senior HR Recruiter and Fraud Detection Specialist. \nAnalyze the candidate's resume against the Job Description AND cross-verify it with the LinkedIn Verification Report provided.\n\nReturn ONLY a valid JSON object. No explanation, no markdown.\n\nCANDIDATE DETAILS:\nName: {{ $json.text.split('\\n')[0] }}\nPosition Applied: {{ $json['Job Title'] }}\n\nRESUME TEXT:\n{{ $json.text }}\n\nJOB DESCRIPTION:\nJob Title: {{ $json['Job Title'] }}\nRequired Skills: {{ $json['Required Skills'] }}\nExperience Required: {{ $json['Experience Required'] }}\n\nVERIFICATION REPORT (LinkedIn vs Resume):\nStatus: {{ $json.verification_status }}\nAuthenticity Score: {{ $json.authenticity_score }}/100\nMajor Discrepancies: {{ $json.discrepancies.join(\", \") }}\nVerification Summary: {{ $json.verification_summary }}\n\nSCORING RULES (STRICT):\n1. If Authenticity Score is below 50, the final \"score\" MUST be 0 or 1, and \"decision\" MUST be \"REJECTED\".\n2. If Status is \"MISMATCHED\", prioritize the discrepancies over the resume skills.\n3. If the candidate has lied about Education or Job Titles, flag it in the summary.\n\nReturn ONLY this JSON structure:\n{\n  \"score\": <integer 1-10>,\n  \"decision\": \"SHORTLISTED\" or \"REJECTED\" or \"MAYBE\",\n  \"match_percentage\": <integer 0-100>,\n  \"authenticity_flag\": \"FAILED\" or \"PASSED\",\n  \"strengths\": [\"list strengths from resume\"],\n  \"gaps\": [\"list missing skills AND mention verification mismatches\"],\n  \"summary\": \"Mention that the candidate failed background verification due to mismatched LinkedIn data.\",\n  \"recommended_interview_type\": \"None\"\n}",
        "options": {}
